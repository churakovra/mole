{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mole:search-query:v1",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "maxLength": 8192
    },
    "focusSymbols": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "paths": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "routeHints": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "topics": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "direction": {
      "type": "string",
      "enum": [
        "forward",
        "reverse",
        "both",
        "none"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "maxNodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "maxEdges": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "additionalProperties": false
}
